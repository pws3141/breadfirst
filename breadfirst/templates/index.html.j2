<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Breadfirst</title>
  <meta name="description" content="Live music in Berlin for the next month.">
  <style>
{{ css | safe }}
  </style>
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <h1 class="logo">Breadfirst</h1>
      <p class="tagline">Live music in Berlin · next 31 days</p>
    </div>
    <nav class="day-strip" aria-label="Jump to a day">
      {% for d in days %}
        {% set has = d in by_day %}
        <a class="day-chip{% if not has %} is-empty{% endif %}{% if d == today %} is-today{% endif %}"
           href="#d-{{ d.isoformat() }}"{% if not has %} aria-disabled="true" tabindex="-1"{% endif %}>
          <span class="day-chip__dow">{{ d.strftime('%a') }}</span>
          <span class="day-chip__num">{{ d.day }}</span>
          {% if d.day == 1 or loop.first %}<span class="day-chip__month">{{ d.strftime('%b') }}</span>{% endif %}
        </a>
      {% endfor %}
    </nav>
  </header>

  <main class="wrap">
    {% for d, events in by_day.items() %}
      <section class="day" id="d-{{ d.isoformat() }}">
        <h2 class="day__heading">
          {% if d == today %}Today · {% endif %}{{ d.strftime('%a') }} {{ d.day | ordinal }} {{ d.strftime('%B') }}{% if d.year != today.year %} {{ d.year }}{% endif %}
        </h2>
        <ul class="events">
          {% for e in events %}
            <li class="event event--{{ e.status.value }}">
              <a class="event__link" href="{{ e.url }}" rel="noopener" target="_blank">
                <div class="event__time">
                  {% if e.start %}{{ e.start }}{% elif e.doors %}<span class="event__doors">doors</span> {{ e.doors }}{% else %}–{% endif %}
                </div>
                <div class="event__body">
                  <h3 class="event__title">{{ e.title }}</h3>
                  {% if e.subtitle %}<p class="event__subtitle">{{ e.subtitle }}</p>{% endif %}
                  <p class="event__meta"><span class="event__type">Live Music</span> — <span class="event__venue">{{ e.venue }}</span></p>
                  {% if e.status.value != 'scheduled' %}
                    <p class="event__status">{{ status_labels[e.status] }}{% if e.status_note %} · <span class="event__note">{{ e.status_note }}</span>{% endif %}</p>
                  {% endif %}
                </div>
              </a>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% else %}
      <p class="empty">No gigs found for the next month. The scraper may be having a bad day.</p>
    {% endfor %}
  </main>

  <footer class="site-footer wrap">
    <p>Listings from
      {% for name, url in venue_sites.items() %}<a href="{{ url }}" rel="noopener" target="_blank">{{ name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.
      Always check the venue before heading out.</p>
    {% if updated_at %}<p>Last updated {{ updated_at.strftime('%a %d %b %Y, %H:%M') }}.</p>{% endif %}
  </footer>
</body>
</html>
